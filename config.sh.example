# jobmon 配置
# 复制本文件到 ~/.config/jobmon/config.sh 后填写，并 chmod 600

# 集群入口：~/.ssh/config 里配好的 Host 别名，需已配置免密登录
# jobmon 通过 `ssh <SSH_HOST> squeue/sacct` 判断作业状态，不碰任何网页接口
SSH_HOST=""
CLUSTER_USER=""

# 钉钉群机器人：群设置 → 智能群助手 → 添加机器人 → 自定义机器人
DINGTALK_WEBHOOK=""
# 安全设置选「加签」时填 SEC 开头的密钥
DINGTALK_SECRET=""
# 安全设置选「自定义关键词」时填关键词（与加签二选一）
DINGTALK_KEYWORD=""

# 1 = 同时弹 macOS 桌面通知，0 = 只推钉钉
POLL_DESKTOP="1"
